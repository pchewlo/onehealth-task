# Required for the agent loop (/api/chat and /api/simulate).
# Everything else — core, MCP tools, the proof script tests 1-8 — runs keyless.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-sonnet-5.
AGENT_MODEL=claude-sonnet-5

# Optional durability: with both set, tickets/audit/metrics/learned rules
# survive restarts and Vercel cold starts (run supabase/schema.sql once in the
# project's SQL editor first). Unset → pure in-memory, exactly as before.
# The service_role key is server-only — never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
